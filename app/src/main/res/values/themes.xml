<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ARIA" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/aria_cyan</item>
        <item name="colorPrimaryVariant">@color/aria_cyan_dim</item>
        <item name="colorOnPrimary">@color/aria_bg_deep</item>
        <item name="colorSecondary">@color/aria_blue</item>
        <item name="colorOnSecondary">@color/aria_text_primary</item>
        <item name="android:colorBackground">@color/aria_bg_deep</item>
        <item name="android:windowBackground">@color/aria_bg_deep</item>
        <item name="android:statusBarColor">@color/aria_bg_deep</item>
        <item name="android:navigationBarColor">@color/aria_bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/aria_text_primary</item>
        <item name="android:textColorSecondary">@color/aria_text_secondary</item>
    </style>

    <style name="ARIADialog" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@color/aria_bg_card</item>
        <item name="colorPrimary">@color/aria_cyan</item>
    </style>

    <style name="ARIAButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/aria_cyan</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/aria_cyan</item>
        <item name="rippleColor">@color/aria_overlay_light</item>
        <item name="cornerRadius">4dp</item>
    </style>
</resources>
