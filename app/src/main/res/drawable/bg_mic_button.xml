<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/aria_cyan"/>
            <stroke android:width="2dp" android:color="@color/aria_cyan_glow"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/aria_bg_card"/>
            <stroke android:width="2dp" android:color="@color/aria_cyan"/>
        </shape>
    </item>
</selector>
